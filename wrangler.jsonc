// Cloudflare configuration for vshape100 v2.
//
// Round 02 adds a Worker (auth API) in front of Static Assets, plus a D1
// binding used ONLY for authentication data (oauth_states, auth_sessions).
//
// Deployment is NOT performed from the build environment. `wrangler deploy`,
// production D1 creation, production migrations and production secrets are
// reserved for local/desktop verification against the real account.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vshape100v2",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-01",
  // Production hostname. A Worker Custom Domain makes Cloudflare provision the
  // DNS record and certificate itself, so no manual CNAME is involved.
  "routes": [
    {
      "pattern": "vshapev2.nkmwei.de",
      "custom_domain": true
    }
  ],
  "assets": {
    "binding": "ASSETS",
    // Route every non-API, non-asset URL to index.html so React Router owns routing.
    "not_found_handling": "single-page-application",
    // SPA not_found_handling answers browser *navigations* for unknown paths
    // with index.html, which would swallow /api/auth/* before the Worker sees
    // them. Worker-first on /api/* keeps the auth routes reachable.
    "run_worker_first": ["/api/*"]
  },
  // Round 14: the reminder sweep. Every minute, because the routine is
  // minute-accurate - a 20:30 item must notify at 20:30, not "some time in
  // that hour". The handler derives what is due from the shared Today engine
  // and sends nothing when VAPID is unconfigured.
  "triggers": {
    "crons": ["* * * * *"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vshape100v2-auth",
      // Created with `wrangler d1 create vshape100v2-auth` (Round 02.5, APAC).
      "database_id": "783552ce-60e0-4685-86e1-19885cff1de9",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
